{
  "manifest_version": 3,
  "name": "CrawlPay",
  "version": "0.1.0",
  "description": "Pay-per-fetch for AI agents. Auto-pay 402 paywalls using USDC on Pharos.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CrawlPay"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
